# ⑫ 交付前必跑的正反双向抽验（铁律二十二 §22-5，缺一不可）：
#   ```bash
#   # ① 正例：每类真实命名变体各取 1 条 ⇒ 必须逐条命中
#   git check-ignore -v --no-index \
#     manu/pipeline/cpp/build-ocl/CMakeFiles/x.json \
#     manu/pipeline/npu/results/x_cands.tsv \
#     manu/memory/qat_trial_0080_qdq_meta/x.json \
#     manu/memory/qat_trial_0080_report/weight_diff.json \
#     manu/memory/<d>/preds_xxx.json \
#     manu/memory/<d>/preds_xxx/VID.json \
#     manu/evaluation/board_runs/x_cands.tsv \
#     manu/video_quality/report/sot_windows.csv \
#     nohup.out core.1234 foo.tar foo.tmp
#   # ② 反例：代码 / 文档 / 证据 ⇒ 必须全部「不命中」（无输出）
#   git check-ignore -q --no-index \
#     manu/pipeline/npu/packaging/build_board_native.sh \
#     manu/pipeline/npu/stat_compat.c \
#     manu/memory/memory.md manu/memory/rules.md \
#     manu/memory/cadence_ab_20261119/vid09_align/v09_cands.tsv \
#     manu/memory/delivery_20261119/artifacts/rt_search_t0080_v3.json \
#     manu/pipeline/npu/board/results/20261112_newboard_thermal/bts_1h_run2_samples.csv \
#     manu/video_quality/report/chart_metrics_vis.png
#   # ③ 已跟踪文件不得被规则误伤（必须无输出）
#   git ls-files | git check-ignore --stdin
#   ```
