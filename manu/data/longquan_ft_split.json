{
  "version": "1.0",
  "created": "2026-10-21",
  "author": "manu",
  "purpose": "龙泉山业务域微调数据集的三轨划分（黄金池守护大盘 + 001324 单帧难例盲测）",
  "rationale": "按 2026-10-20 全量评测的实测表现与失效归因划分：Val 守大盘防退化，Train 采失效机理养料，Ignore 剔除脏数据避免梯度污染。",
  "sampling": {
    "val_stride": 1,
    "val_start": 0,
    "val_note": "全帧 0 间隔，含第 0 帧；与 2026-10-20 冻结单帧 baseline 的帧集合逐帧一致（golden pool 17187 帧 / 001324 11810 帧）",
    "train_stride": 5,
    "train_start": 0,
    "train_note": "每 5 帧抽 1 帧，起点 0；Anti-UAV 参考集 uav 的 train 为步长 5（起点 6）、val 为步长 1，若需完全复刻可传 --train-start 6",
    "anti_uav_reference": {
      "dataset": "/mnt/data/siping/datasets/manu/uav",
      "train_sequences": 185,
      "train_step": 5,
      "train_first_index": 6,
      "val_sequences": 20,
      "val_step": 1,
      "val_first_index": 3,
      "data_yaml": "path: /mnt/data/siping/datasets/manu/uav | train: images/train | val: images/val | names: {0: uav}"
    }
  },
  "feature_spec": {
    "layout": "3 通道 JPG，磁盘通道序 [I_t, |I_t - W(I_{t-2})|, (I_t - B_t)^+]",
    "model_channel_order": "推理时需反转为 [median_residual, gmc_diff, I_t]（见 manu/data/multiscale_heatmap_cache.py）",
    "window": 21,
    "stride_step": 2,
    "downscale": 2,
    "gmc_semantics": "逐 lag 直接拟合（compute_affine(h, t)），与 manu/data/build_full_median_dataset.py 一致；禁用 FPV 仿射连乘变体",
    "naming": "<sequence>__frame_<真值帧号:06d>.jpg，与同名 .txt 1:1 镜像"
  },
  "groups": {
