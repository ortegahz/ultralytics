{
  "version": "1.0",
  "created": "2026-11-10",
  "author": "manu",
  "purpose": "纵横AI数据采集域的序列划分（58 条 mp4，无 GT）：按 RC2 单帧多尺度检测的实际覆盖把序列分成 val / train / ignore 三桶，供人工复核、后续标注与训练使用",
  "rationale": "本域**没有 GT**，因此划分**不是质量判定**，只记录「模型看到了什么」：检测覆盖率高 ⇒ 稳定正样本候选（val/黄金池）；覆盖断续 ⇒ 正负切片养料（train）；几乎不响应 ⇒ 本域无法区分空场景与漏检，先隔离（ignore）。最终取舍由人工复核底稿 manu/docs/dataset/zongheng-tk.md 拍板，标注完成后回填真实指标（沿用龙泉山的 single_frame_f1 字段名，不另起字段）。",
  "sampling": {
    "val_stride": 1,
    "val_start": 0,
    "val_note": "本域当前无 GT，尚未抽帧；人工复核与标注后按步长 1 全帧进 val",
    "train_stride": 5,
    "train_start": 0,
    "train_note": "标注后每 5 帧抽 1 帧进 train（起点 0），与龙泉山同口径",
    "anti_uav_reference": {
      "dataset": "/mnt/data/siping/datasets/manu/uav",
      "train_sequences": 185,
      "train_step": 5,
      "train_first_index": 6,
      "val_sequences": 20,
      "val_step": 1,
      "val_first_index": 3,
      "data_yaml": "path: /mnt/data/siping/datasets/manu/uav | train: images/train | val: images/val | names: {0: uav}"
    }
  },
  "feature_spec": {
    "layout": "3 通道特征，磁盘通道序 [I_t, |I_t - W(I_{t-2})|, (I_t - B_t)^+]（内存现算，不落盘）",
    "model_channel_order": "推理时需反转为 [median_residual, gmc_diff, I_t]（见 manu/data/multiscale_heatmap_cache.py）",
    "window": 21,
    "stride_step": 2,
    "downscale": 2,
    "gmc_semantics": "逐 lag 直接拟合（compute_affine(h, t)），与 manu/data/build_full_median_dataset.py 一致；禁用 FPV 仿射连乘变体",
    "naming": "<sequence>__frame_<真值帧号:06d>.jpg，与同名 .txt 1:1 镜像",
    "crop": {
      "source": "1920x1080 录制画幅，先按 (left=320, top=0, w=1280, h=1024) 裁回原生，再缩到 640x512",
      "native_size": [
        640,
        512
      ],
      "note": "与龙泉山原生画幅一致 ⇒ RC2 在龙泉山实测的工作点可原样搬过来"
    }
  },
  "groups": {
    "val": {
      "description": "30 条：RC2 稳定检出（覆盖 >= 50%），本域黄金池候选",
