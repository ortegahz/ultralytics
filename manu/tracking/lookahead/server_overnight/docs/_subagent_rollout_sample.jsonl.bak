{"timestamp":"2026-11-02T08:47:17.182Z","ordinal":45,"type":"event_msg","payload":{"type":"item_completed","thread_id":"01a19b70-7336-77f2-a5a5-f8aefbea889b","turn_id":"01a19b70-7341-7e12-98d5-3e6b1c15e0f0","item":{"type":"CommandExecution","id":"call_01a19b70f59b731db2b7edcc","process_id":"66686","command":["/bin/bash","-lc","cd /media/manu/1TB-Volume/workspace/ultralytics && echo \"=== diff orig vs lookahead ===\" && diff -u manu/evaluation/system_sota_longquan.py manu/tracking/lookahead/lookahead_longquan.py | head -120 && echo \"=== DIFF_EXIT=$? ===\""],"cwd":"file:///media/manu/1TB-Volume/workspace","parsed_cmd":[{"type":"unknown","cmd":"cd /media/manu/1TB-Volume/workspace/ultralytics && echo \"=== diff orig vs lookahead ===\" && diff -u manu/evaluation/system_sota_longquan.py manu/tracking/lookahead/lookahead_longquan.py | head -120 && echo \"=== DIFF_EXIT=$? ===\""}],"source":"unified_exec_startup","status":"completed","aggregated_output":"=== diff orig vs lookahead ===\n--- manu/evaluation/system_sota_longquan.py\t2026-10-20 16:59:09.243640814 +0800\n+++ manu/tracking/lookahead/lookahead_longquan.py\t2026-11-02 16:42:50.834289845 +0800\n@@ -2,6 +2,11 @@\n # Ultralytics 🚀 AGPL-3.0 License - https://ultralytics.com/license\n \"\"\"Longquanshan adapter for the Anti-UAV system-SOTA post-processing pipeline.\n \n+本文件是 ``manu/evaluation/system_sota_longquan.py`` 的拷贝，外挂「快速前向推演」\n+（look-ahead extrapolator）：在成熟管线的输出末端，把上报给转台的坐标从「t−Δ 帧的旧位置」\n+推到「当前物理帧 t」。原文件不得修改；本拷贝只做契约允许的改动，其中 ``--lookahead off``\n+必须与原脚本**逐位一致**（外挂是纯后处理，绝不改写历史估计）。\n+\n The system pipeline (``manu/evaluation/eval_bidirectional_track_fusion.py``) is reused untouched. This module only\n \n * adapts the Longquanshan multi-scale heatmap cache (``runs/ms_cache_nop0/<SEQ>.pkl``) into the record format the\n@@ -20,18 +25,16 @@\n import pickle\n import sys\n import time\n+from collections import OrderedDict\n from pathlib import Path\n \n+import cv2\n import numpy as np\n \n-PROJECT_ROOT = Path(__file__).resolve().parents[2]\n+PROJECT_ROOT = Path(__file__).resolve().parents[3]\n if str(PROJECT_ROOT) not in sys.path:\n     sys.path.insert(0, str(PROJECT_ROOT))\n \n-from manu.evaluation.eval_bidirectional_track_fusion import (  # noqa: E402\n-    evaluate_sequence_bidirectional,\n-    natural_sort_key,\n-)\n from manu.evaluation.eval_multiscale_cache_th import (  # noqa: E402\n     COUNT_KEYS,\n     count_matches,\n@@ -40,6 +43,15 @@\n     merge_scales,\n     metrics,\n )\n+from manu.tracking.lookahead.extrapolator import (  # noqa: E402\n+    LookaheadConfig,\n+    build_report_stream,\n+    servo_metrics,\n+)\n+from manu.tracking.lookahead.track_fusion import (  # noqa: E402\n+    evaluate_sequence_bidirectional,\n+    natural_sort_key,\n+)\n \n IMG_W = 640\n IMG_H = 512\n@@ -276,7 +288,12 @@\n     }\n \n \n-def run_system_sota(records: list[dict], params: dict, img_h: int = IMG_H) -> tuple[list[list[dict]], dict]:\n+def run_system_sota(\n+    records: list[dict],\n+    params: dict,\n+    img_h: int = IMG_H,\n+    capture_kf_states: bool = False,\n+) -> tuple[list[list[dict]], dict]:\n     \"\"\"Run the Anti-UAV system pipeline on the Longquanshan records and apply the consecutive-frame gate.\n \n     Returns the (filtered) per-frame detections and the raw system report. The system report holds the\n@@ -294,6 +311,7 @@\n         tracker_config=build_tracker_config(params, img_h),\n         smoother_config=build_smoother_config(params, img_h),\n         match_mode=\"bbox\",\n+        capture_kf_states=capture_kf_states,\n     )\n     dets = apply_consecutive_confirmation(\n         res[\"bidi_frame_dets\"],\n@@ -426,6 +444,248 @@\n \n \n # ==============================================================================\n+# 3.1 Look-ahead 外挂：四臂对照（尺子 1 / 尺子 2）\n+# ==============================================================================\n+\n+# 对照臂 ↔ 外推档位：original 是原脚本自己的输出（无滞后，精度天花板），\n+# 其余三臂分别对应契约 §1 的 stale / kinematic / replay。\n+ARM_MODES = {\"original\": \"off\", \"stale\": \"stale\", \"kinematic\": \"kinematic\", \"replay\": \"replay\"}\n+\n+\n+class SequenceFrameSource:\n+    \"\"\"按**管线时间轴**（record 下标）取灰度整帧。\n+\n+    record 下标与视频里的绝对帧号不是一回事（绝对帧号存在 ``records[i][\"frame_index\"]``），\n+    所以这里先把 record 下标映射回绝对帧号再取图。缓存只留最近 ``delta + 2`` 张：\n+    replay 的重推区间是 ``f+1..f+Δ``，正好落在缓存窗口内 ⇒ 每帧只读一次。\n+    \"\"\"\n+\n+    def __init__(self, frames_root, frame_indices: list[int], delta: int):\n+        self.root = Path(frames_root)\n+        self.frame_indices = list(frame_indices)\n+        self.capacity = max(2, int(delta) + 2)\n+        self.reads = 0\n+        self._cache: OrderedDict[int, np.ndarray] = OrderedDict()\n+\n+    def get(self, frame_index: int) -> np.ndarray | None:\n+        \"\"\"取 record 下标对应的灰度帧；缺文件返回 ``None``。\"\"\"\n+        key = int(frame_index)\n+        cached = self._cache.get(key)\n+        if cached is not None:\n+            self._cache.move_to_end(key)\n+            return cached\n+        if key < 0 or key >= len(self.frame_indices):\n+            return None\n+        path = self.root / f\"frame_{self.frame_indices[key]:06d}.jpg\"\n+        image = cv2.imread(str(path), cv2.IMREAD_GRAYSCALE)\n+        if image is None:\n+            # 部分 OpenCV 构建的 imread 处理不了含中文的路径，用 imdecode 兜底（帧根目录里有「龙泉山」）。\n+            try:\n+                buffer = np.fromfile(path, dtype=np.uint8)\n+            except OSError:\n+                return None\n+            if not buffer.size:\n+                return None\n=== DIFF_EXIT=0 ===\n","exit_code":0,"duration":{"secs":0,"nanos":28904}},"started_at_ms":1793609237181,"completed_at_ms":1793609237182}}
