":"read","missing_path_behavior":"skip"},{"path":{"type":"path","path":"/media/manu/1TB-Volume/workspace/.aws"},"access":"read","missing_path_behavior":"skip"}]},"model":"MiniMax-M3.1-Flash","collaboration_mode":{"mode":"default","settings":{"model":"MiniMax-M3.1-Flash","reasoning_effort":"max","developer_instructions":null}},"multi_agent_version":"v1","realtime_active":false,"effort":"max","summary":"none"}}
