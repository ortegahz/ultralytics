# Build artifacts -- regenerated by build_board_probe.sh, never committed.
.build-include/
.hostcheck/
out/

# Benchmark run results -- regenerated by guarantee_run.sh / x86_evidence_regen.sh.
# Per-frame CSVs, arm directories, bench logs and md5 dumps are raw measurements,
# never committed. The *.txt summary tables directly in .bench_out/ are the
# evidence trail backing GMC_HANDLE_DELIVERY.md and ARE tracked.
.bench_out/*/
.bench_out/*.csv
.bench_out/*.log
.bench_out/*.out
.bench_out/*.tsv
.bench_out/md5_*.txt
.bench_bmp/
